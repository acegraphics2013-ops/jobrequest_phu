{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "phu-chat",
  "version": "1.0.0",
  "identifier": "com.phu.jobrequest.chat",
  "build": {
    "frontendDist": "http://localhost/jobrequest_phu/chat_center.php",
    "devUrl": "http://localhost/jobrequest_phu/chat_center.php"
  },
  "app": {
    "windows": [
      {
        "title": "PHU Workbench - Chat Center",
        "width": 1050,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
